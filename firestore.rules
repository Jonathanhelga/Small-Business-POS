rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    //{uid} / {docId} Filled by the path the client sends. Always the document ID.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Per-owner counter backing the atomic auto-SKU reservation in reserveNextSku().
    // Keyed by uid like /users/{uid} so ownership is just an ID match.
    match /skuCounters/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    //request.auth = the whole login info of user whose making the request if they are not logged in its a null
    //request.auth.uid = just the user's ID, pulled out of that login info.
    //request.resource.data = the new data the client is trying to write. Only exists for create and update, not for read or delete.
    // Deletes are denied outright: they run through the backend
    // (/api/inventory/delete), which verifies the Admin PIN and the ownerId
    // before deleting with firebase-admin. Rules cannot see the PIN, so a
    // client-side delete could never be gated on it.
    match /inventory/{docId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow delete: if false;

      match /stockUpdates/{updateId} {
        allow read, create: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/inventory/$(docId)).data.ownerId;
      }

      match /metaUpdates/{updateId} {
        allow read, create: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/inventory/$(docId)).data.ownerId;
      }
    }
    
    // Same as /inventory: deletes go through /api/orders/delete, which also
    // restocks and rolls back promo usage inside one transaction.
    match /orders/{docId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow delete: if false;
    }
    match /customers/{docId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }

    // OTPs are managed exclusively by the backend (firebase-admin bypasses these rules).
    // Deny all client access so signup codes can't be read or tampered with from the browser.
    match /otps/{email} {
      allow read, write: if false;
    }

    // Admin PIN hashes are managed exclusively by the backend (firebase-admin bypasses
    // these rules), same as /otps. Deny all client access so the hash/salt can never be
    // read into the browser and brute-forced offline in a devtools console.
    match /adminPins/{uid} {
      allow read, write: if false;
    }
  }
}